{
  "_meta": {
    "name": "图生图",
    "description": "基于参考图重绘（LoadImage → VAEEncode → KSampler），上传图片后生成"
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "" },
    "_meta": { "title": "加载模型" }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "" },
    "_meta": { "title": "参考图" }
  },
  "11": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["10", 0], "vae": ["4", 2] },
    "_meta": { "title": "VAE 编码" }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 123456789,
      "steps": 30,
      "cfg": 7,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.75,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["11", 0]
    },
    "_meta": { "title": "KSampler" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "masterpiece, best quality", "clip": ["4", 1] },
    "_meta": { "title": "正向提示词" }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "lowres, bad anatomy, bad hands, blurry", "clip": ["4", 1] },
    "_meta": { "title": "负向提示词" }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["4", 2] },
    "_meta": { "title": "VAE 解码" }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "director_img2img", "images": ["8", 0] },
    "_meta": { "title": "生成图片" }
  }
}
